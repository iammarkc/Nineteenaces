rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function canAccessOffice(office) {
      return request.auth != null
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions.hasAny(['inventory'])
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.inventoryAccess.hasAny([office]);
    }

    match /userProfiles/{uid} {
      allow read: if request.auth != null;
      allow create, delete: if false;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['theme']);
    }

    match /announcements/{announcementId} {
      allow read, write: if request.auth != null;
    }
    match /onlinePresence/{sessionId} {
      allow read, write: if request.auth != null;
    }
    match /onlineChats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    match /inventoryData/{office} {
      allow read, write: if office != 'Cebu' && canAccessOffice(office);
    }
    match /inventoryHistory/{office} {
      allow read, write: if office != 'Cebu' && canAccessOffice(office);
    }
  }
}
