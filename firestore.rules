rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Attendance module
    match /attendanceRecords/{recordId} {
      allow read, write: if true;
    }
    match /attendanceRecordDeletions/{recordId} {
      allow read, write: if true;
    }
    match /attendanceHistory/{entryId} {
      allow read, write: if true;
    }
    match /attendanceTasks/{taskId} {
      allow read, write: if true;
    }
    match /attendanceTaskDeletions/{taskId} {
      allow read, write: if true;
    }

    // To-Do List module
    match /todoTasks/{taskId} {
      allow read, write: if true;
    }
    match /todoTaskDeletions/{taskId} {
      allow read, write: if true;
    }
  }
}
